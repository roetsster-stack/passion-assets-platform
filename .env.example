# Copy to .env.local for local development. Real values live in Vercel (Project → Settings →
# Environment Variables) and in ~/curator/.env on Workshop — never in chat, never in the iCloud folder.

# Supabase — project "curator-v1", region London (eu-west-2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only; used by the ingest and admin jobs

# Cloudflare R2 — masters (write-once) and renditions
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MASTERS=curator-masters
R2_BUCKET_RENDITIONS=curator-renditions

# Airtable — the source register for the V1 ingest (base "Michael Roets Collection")
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appD61Q3H9a1qxswB

# Anthropic — the product's own AI features, from M2
ANTHROPIC_API_KEY=

# Postgres — the ingest connects directly (Supabase → Connect → "Session pooler" URI, or the direct URI).
# TLS is verified against the system roots; set DATABASE_SSL_CA to Supabase's CA file if the roots
# do not cover it, or DATABASE_SSL=disable for a local database only.
DATABASE_URL=
# DATABASE_SSL_CA=~/curator/supabase-ca.crt

# Optional: the collection the ingest writes to (created on first run)
# CURATOR_COLLECTION_NAME=Michael Roets Collection
